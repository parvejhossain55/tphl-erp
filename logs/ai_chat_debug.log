GENERATED SQL: -- Material Cost Used:
SELECT SUM(mri.received_quantity * poi.unit_price) AS material_cost
FROM material_receiving_items mri
JOIN material_receiving mr ON mri.receiving_id = mr.id
JOIN purchase_order_items poi ON poi.id = mri.purchase_order_item_id
JOIN purchase_orders po ON po.id = mr.purchase_order_id
JOIN purchase_requests pr ON pr.id = po.request_id
WHERE mr.overall_status = 'Accepted' AND pr.project_id = 13;
