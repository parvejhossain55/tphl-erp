     WHERE mr.overall_status = 'Accepted' AND pr.project_id = 13) AS material_cost,
    (SELECT SUM(amount_paid)
     FROM con_financial_transactions
     WHERE project_id = 13 AND ref_type = 'contractor_bill' AND update_status = 'Completed') AS contractor_cost
