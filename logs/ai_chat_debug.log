GENERATED SQL: SELECT 
    p.name AS project_name,
    cm.name AS material_name,
    cmc.name AS category_name,
    cft.amount_paid,
    cft.transaction_date_str
FROM con_financial_transactions cft
JOIN projects p ON cft.project_id = p.id
LEFT JOIN boq_master bm ON bm.project_id = p.id
LEFT JOIN boq_items bi ON bi.boq_id = bm.id
LEFT JOIN con_materials cm ON bi.material_id = cm.id
LEFT JOIN con_material_categories cmc ON cm.category_id = cmc.id
WHERE cft.ref_type = 'vendor_payment' AND cft.update_status = 'Completed'
ORDER BY p.name, cft.transaction_date_str;
