promptTokenCount":6346,"candidatesTokenCount":595,"totalTokenCount":6941,"cachedContentTokenCount":4064,"promptTokensDetails":[{"modality":"TEXT","tokenCount":6346}],"cacheTokensDetails":[{"modality":"TEXT","tokenCount":4064}],"serviceTier":"standard"},"modelVersion":"gemini-3.1-flash-lite","responseId":"A1guapvRLrm74-EP86ri0Qk"}
GENERATED SQL: -- Workflow is phase_based, calculating dynamic progress
SELECT 
    SUM(planned_pct) AS total_planned_progress,
    SUM(actual_pct) AS total_actual_progress
FROM (
    SELECT 
        ppid.phase_item_id,
        ppid.work_type_id,
        (COALESCE(LEAST(1.0, COALESCE(plan_data.total_target_qty, 0) / NULLIF(ppid.total_boq_qty, 0)), 0) * ppid.weight_pct * (pp.weight_percentage / 100)) AS planned_pct,
        (COALESCE(LEAST(1.0, COALESCE(act_data.total_actual_qty, 0) / NULLIF(ppid.total_boq_qty, 0)), 0) * ppid.weight_pct * (pp.weight_percentage / 100)) AS actual_pct
    FROM project_phase_item_details ppid
    JOIN project_phase_items ppi ON ppid.phase_item_id = ppi.id
    JOIN project_phases pp ON ppi.phase_id = pp.id
    LEFT JOIN (
        SELECT phase_item_id, work_type_id, SUM(monthly_target_qty) AS total_target_qty
        FROM phase_monthly_target_items
        GROUP BY phase_item_id, work_type_id
    ) AS plan_data ON ppid.phase_item_id = plan_data.phase_item_id AND ppid.work_type_id = plan_data.work_type_id
    LEFT JOIN (
        SELECT phase_item_id, work_type_id, SUM(achieved_qty) AS total_actual_qty
        FROM phase_weekly_progress_items pwpi
        JOIN phase_monthly_target_items pmti ON pwpi.target_item_id = pmti.id
        JOIN phase_weekly_progress pwp ON pwpi.weekly_progress_id = pwp.id
        WHERE pwp.qc_status = 'Approved' AND pwp.pm_status = 'Approved'
        GROUP BY phase_item_id, work_type_id
    ) AS act_data ON ppid.phase_item_id = act_data.phase_item_id AND ppid.work_type_id = act_data.work_type_id
    WHERE pp.project_id = 13
) AS progress_calculation;
