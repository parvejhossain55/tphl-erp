GENERATED SQL: SELECT 
    cm.name AS material_name,
    cmc.name AS category_name,
    SUM(poi.quantity) AS total_qty,
    cm.unit
FROM purchase_order_items poi
JOIN purchase_orders po ON poi.purchase_order_id = po.id
JOIN purchase_requests pr ON po.request_id = pr.id
LEFT JOIN con_materials cm ON poi.material_id = cm.id
LEFT JOIN con_material_categories cmc ON cm.category_id = cmc.id
WHERE pr.project_id = 13
  AND po.status IN ('Approved', 'Partially Received', 'Fully Received')
GROUP BY cm.name, cmc.name, cm.unit;
