GENERATED SQL: SELECT 
    p.name AS project_name,
    pt.construction_start_date,
    pt.construction_end_date,
    pt.expected_handover_date,
    SUM(ieb.total_estimated_cost) AS total_budget
FROM projects p
JOIN project_timelines pt ON p.id = pt.project_id
LEFT JOIN initial_estimate_budgets ieb ON p.id = ieb.project_id
WHERE p.deleted_at IS NULL
  AND pt.current_status = 'Construction'
  AND ieb.status IN ('approved', 'pm_approved')
GROUP BY p.id, p.name, pt.construction_start_date, pt.construction_end_date, pt.expected_handover_date;
