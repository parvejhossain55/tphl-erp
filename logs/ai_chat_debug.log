GENERATED SQL: SELECT 
    p.name AS project_name,
    SUM(pp.weight_percentage * pp.actual_progress / 100) AS total_actual_progress,
    SUM(pp.weight_percentage * (SELECT AVG(ppi.planned_progress) FROM project_phase_items ppi WHERE ppi.phase_id = pp.id) / 100) AS total_planned_progress
FROM projects p
JOIN project_phases pp ON p.id = pp.project_id
WHERE p.deleted_at IS NULL
GROUP BY p.id;
