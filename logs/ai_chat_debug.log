GENERATED SQL: SELECT 
    SUM(planned_pct) AS total_planned_progress,
    SUM(actual_pct) AS total_actual_progress
FROM (
    SELECT 
        ppid.id AS detail_id,
        LEAST(1.0, COALESCE(plan_data.total_target_qty, 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct * (pp.weight_percentage / 100) AS planned_pct,
        LEAST(1.0, COALESCE(act_data.total_actual_qty, 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct * (pp.weight_percentage / 100) AS actual_pct
    FROM project_phases pp
    JOIN project_phase_items ppi ON pp.id = ppi.phase_id
    JOIN project_phase_item_details ppid ON ppi.id = ppid.phase_item_id
    LEFT JOIN (
        SELECT phase_item_id, work_type_id, SUM(monthly_target_qty) AS total_target_qty 
        FROM phase_monthly_target_items 
        GROUP BY phase_item_id, work_type_id
    ) plan_data ON plan_data.phase_item_id = ppi.id AND plan_data.work_type_id = ppid.work_type_id
    LEFT JOIN (
        SELECT pwpi.target_item_id, SUM(pwpi.achieved_qty) AS total_actual_qty
        FROM phase_weekly_progress_items pwpi
        JOIN phase_monthly_target_items pmti ON pwpi.target_item_id = pmti.id
        WHERE pwpi.status = 'Completed'
        GROUP BY pmti.phase_item_id, pmti.work_type_id
    ) act_data ON act_data.target_item_id = ppi.id
    WHERE pp.project_id = 13
) AS progress_summary;
