GENERATED SQL: SELECT 
    p.name AS project_name, 
    ie.total_estimated_cost AS budget 
FROM projects p
JOIN project_phases pp ON p.id = pp.project_id
JOIN initial_estimate_budgets ie ON p.id = ie.project_id
WHERE p.deleted_at IS NULL 
  AND pp.status = 'In Progress' 
  AND ie.status IN ('approved', 'pm_approved')
GROUP BY p.id;
