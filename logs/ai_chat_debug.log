GENERATED SQL: SELECT 
    p.name AS project_name,
    COALESCE(ieb.total_estimated_cost, 0) AS total_budget,
    COALESCE(SUM(cft.amount_paid), 0) AS total_spent,
    (COALESCE(ieb.total_estimated_cost, 0) - COALESCE(SUM(cft.amount_paid), 0)) AS remaining_budget
FROM projects p
LEFT JOIN initial_estimate_budgets ieb ON p.id = ieb.project_id AND ieb.status IN ('approved', 'pm_approved')
LEFT JOIN con_financial_transactions cft ON p.id = cft.project_id AND cft.update_status = 'Completed'
WHERE p.id = 13 AND p.deleted_at IS NULL
GROUP BY p.id;
