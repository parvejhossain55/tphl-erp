GENERATED SQL: SELECT 
    p.name AS project_name, 
    pp.phase_name, 
    pmti.work_item_name, 
    pmti.monthly_target_qty, 
    pmti.actual_qty, 
    pmti.actual_progress_pct 
FROM projects p
JOIN project_phases pp ON p.id = pp.project_id
JOIN phase_monthly_targets pmt ON pp.id = pmt.phase_id
JOIN phase_monthly_target_items pmti ON pmt.id = pmti.target_id
WHERE p.deleted_at IS NULL
AND pp.status = 'In Progress'
ORDER BY p.name, pp.phase_order;
