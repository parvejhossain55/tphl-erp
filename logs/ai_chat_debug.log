GENERATED SQL: 
SELECT
    SUM(
        COALESCE(
            LEAST(1.0, COALESCE(plan_sub.total_target_qty, 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct,
            0
        ) * (pp.weight_percentage / 100)
    ) AS planned_progress_pct,
    SUM(
        COALESCE(
            LEAST(1.0, COALESCE(act_sub.total_actual_qty, 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct,
            0
        ) * (pp.weight_percentage / 100)
    ) AS actual_progress_pct
FROM project_phases pp
JOIN project_phase_items ppi ON pp.id = ppi.phase_id
JOIN project_phase_item_details ppid ON ppi.id = ppid.phase_item_id
LEFT JOIN (
    SELECT pmti.phase_item_id, SUM(pmti.monthly_target_qty) AS total_target_qty
    FROM phase_monthly_target_items pmti
    JOIN phase_monthly_targets pmt ON pmti.target_id = pmt.id
    WHERE pmt.project_id = 13
    GROUP BY pmti.phase_item_id
) AS plan_sub ON ppi.id = plan_sub.phase_item_id
LEFT JOIN (
    SELECT pmti.phase_item_id,
           SUM(COALESCE(pwpi.achieved_qty, 0)) AS total_actual_qty
    FROM phase_monthly_target_items pmti
    JOIN phase_weekly_progress_items pwpi ON pmti.id = pwpi.target_item_id
    JOIN phase_weekly_progress pwp ON pwpi.weekly_progress_id = pwp.id
    WHERE pwp.project_id = 13
      AND pwp.qc_status = 'Approved'
      AND pwp.pm_status = 'Approved'
    GROUP BY pmti.phase_item_id
) AS act_sub ON ppi.id = act_sub.phase_item_id
WHERE pp.project_id = 13;

