GENERATED SQL: SELECT 
    SUM(planned_pct) AS total_planned_progress,
    SUM(actual_pct) AS total_actual_progress
FROM (
    SELECT 
        ppid.phase_item_id,
        ppid.work_type_id,
        (COALESCE(SUM(plan_data.monthly_target_qty), 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct * (pp.weight_percentage / 100) AS planned_pct,
        (COALESCE(SUM(act_data.total_achieved), 0) / NULLIF(ppid.total_boq_qty, 0)) * ppid.weight_pct * (pp.weight_percentage / 100) AS actual_pct
    FROM project_phases pp
    JOIN project_phase_items ppi ON pp.id = ppi.phase_id
    JOIN project_phase_item_details ppid ON ppi.id = ppid.phase_item_id
    LEFT JOIN (
        SELECT target_item_id, monthly_target_qty 
        FROM phase_monthly_target_items
    ) plan_data ON plan_data.target_item_id = ppi.id 
    LEFT JOIN (
        SELECT 
            target_item_id, 
            SUM(achieved_qty) AS total_achieved 
        FROM phase_weekly_progress_items 
        GROUP BY target_item_id
    ) act_data ON act_data.target_item_id = ppi.id
    WHERE pp.project_id = 13
    GROUP BY ppid.phase_item_id, ppid.work_type_id, ppid.total_boq_qty, ppid.weight_pct, pp.weight_percentage
) AS progress_summary;
