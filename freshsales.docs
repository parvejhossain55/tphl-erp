🔷 PHASE 7 — DigitalMarketingController Method
File: 
app/controllers/DigitalMarketingController.php

php

public function freshsalesLeadsPage()
{
    if (session_status() === PHP_SESSION_NONE) session_start();
    // Role check (DMT/Admin only)
    
    // Filters read
    $platform = $_GET['platform'] ?? '';
    $status = $_GET['status'] ?? '0'; // default Pending (is_exported = 0)
    $fromDate = $_GET['from_date'] ?? '';
    $toDate = $_GET['to_date'] ?? '';
    // Build Query
    $sql = "SELECT * FROM freshsales_leads_cache WHERE 1=1";
    $params = [];
    $types = "";
    if ($platform !== '') {
        $sql .= " AND platform = ?";
        $params[] = $platform;
        $types .= "s";
    }
    if ($status !== 'all') {
        $sql .= " AND is_exported = ?";
        $params[] = (int)$status;
        $types .= "i";
    }
    if (!empty($fromDate) && !empty($toDate)) {
        $sql .= " AND DATE(created_at) BETWEEN ? AND ?";
        $params[] = $fromDate;
        $params[] = $toDate;
        $types .= "ss";
    }
    $sql .= " ORDER BY created_at DESC";
    $stmt = $this->db->prepare($sql);
    if (!empty($params)) {
        $stmt->bind_param($types, ...$params);
    }
    $stmt->execute();
    $leads = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
    // Load view
    require dirname(__DIR__) . '/views/digital_marketing/freshsales_leads.php';
}
