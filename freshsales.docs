🔷 PHASE 3 — Service Layer (Data Parser)
File: app/services/FreshsalesService.php

php

<?php
class FreshsalesService
{
    private array $config;
    public function __construct(array $config)
    {
        $this->config = $config;
    }
    /**
     * Webhook security signature ভেরিফাই করে
     */
    public function verifySignature(string $rawPayload, string $receivedSig): bool
    {
        $secret = $this->config['freshsales_webhook_secret'] ?? '';
        if (empty($secret)) return true; // dev bypass
        $expected = hash_hmac('sha256', $rawPayload, $secret);
        return hash_equals($expected, $receivedSig);
    }
    /**
     * Freshsales source name কে আমাদের standard platform এ ম্যাপ করে
     */
    public function mapPlatform(?string $sourceName): string
    {
        if (empty($sourceName)) return 'other';
        $s = strtolower(trim($sourceName));
        if (str_contains($s, 'facebook') || str_contains($s, ' fb ') || $s === 'fb') {
            return 'facebook';
        }
        if (str_contains($s, 'instagram') || str_contains($s, 'ig')) {
            return 'instagram';
        }
        if (str_contains($s, 'whatsapp')) {
            return 'whatsapp';
        }
        if (str_contains($s, 'google')) {
            return 'google';
        }
        if (str_contains($s, 'youtube')) {
            return 'youtube';
        }
        return $s;
    }
}
🔷 PHASE 4 — Webhook Controller (ডাটা সেভ ও এক্সপোর্ট লজিক)
File: app/controllers/LeadWebhookController.php

php

<?php
class LeadWebhookController extends Controller
{
    protected $db;
    protected FreshsalesService $freshsalesService;
    public function __construct($db)
    {
        $this->db = $db;
        $config = require dirname(__DIR__) . '/config/config.php';
        $this->freshsalesService = new FreshsalesService($config);
    }
    // ──────────────────────────────────────────────────────────────
    // 1. Webhook Endpoint: Freshsales থেকে ডাটা ক্যাশ টেবিলে সেভ করে
    // ──────────────────────────────────────────────────────────────
    public function receive(): void
    {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->respond(405, 'Method Not Allowed');
            return;
        }
        $rawPayload = file_get_contents('php://input');
        $signature = $_SERVER['HTTP_X_FRESHSALES_SIGNATURE'] ?? '';
        if (!$this->freshsalesService->verifySignature($rawPayload, $signature)) {
            $this->respond(401, 'Unauthorized');
            return;
        }
        $payload = json_decode($rawPayload, true);
        if (empty($payload)) {
            $this->respond(400, 'Invalid JSON');
            return;
        }
        $lead = $payload['lead'] ?? $payload['data'] ?? $payload;
        
        $firstName = trim($lead['first_name'] ?? '');
        $lastName = trim($lead['last_name'] ?? '');
        $fullName = trim("$firstName $lastName") ?: ($lead['name'] ?? 'Unknown');
        
        $phone = $lead['mobile_number'] ?? $lead['phone'] ?? null;
        if (empty($phone)) {
            $this->jsonResponse(200, 'Skipped: No Phone');
            return;
        }
        $freshsalesId = $lead['id'] ?? null;
        $platform = $this->freshsalesService->mapPlatform($lead['lead_source']['name'] ?? $lead['source'] ?? null);
        $campaign = $lead['campaign_name'] ?? ($lead['custom_field']['campaign_name'] ?? null);
        $city = $lead['city'] ?? null;
        $country = $lead['country'] ?? 'Bangladesh';
        $email = $lead['email'] ?? null;
        $jobTitle = $lead['job_title'] ?? null;
        $companyName = $lead['company_name'] ?? null;
        // Custom Fields Mapping (প্রশ্নোত্তর ফিল্ডসমূহ)
        $custom = $lead['custom_field'] ?? [];
        $aptSize = $custom['which_apartment_size_are_you_interested_in'] ?? null;
        $shopFloor = $custom['which_floor_are_you_for_shop'] ?? null;
        $whenBuy = $custom['when_are_you_planning_to_buy'] ?? null;
        $siteVisit = $custom['would_you_like_to_schedule_a_site_visit'] ?? null;
        $bestTime = $custom['when_is_the_best_time_to_contact_you'] ?? null;
        // ক্যাশ টেবিলে ডুপ্লিকেট সেভ হওয়া রোধ করবে
        $stmt = $this->db->prepare("
            INSERT INTO freshsales_leads_cache 
                (freshsales_id, campaign_name, platform, 
                 which_apartment_size_are_you_interested_in, which_floor_are_you_for_shop, 
                 when_are_you_planning_to_buy, would_you_like_to_schedule_a_site_visit, 
                 when_is_the_best_time_to_contact_you, full_name, job_title, company_name, 
                 phone_number, city, country, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NOW())
            ON DUPLICATE KEY UPDATE
                full_name = VALUES(full_name),
                campaign_name = VALUES(campaign_name),
                phone_number = VALUES(phone_number)
        ");
        
        $stmt->bind_param('ssssssssssssss', 
            $freshsalesId, $campaign, $platform, 
            $aptSize, $shopFloor, $whenBuy, $siteVisit, $bestTime, 
            $fullName, $jobTitle, $companyName, $phone, $city, $country
        );
        
        if ($stmt->execute()) {
            $this->saveLog('lead.created', $freshsalesId, $platform, $phone, 'success', null);
            $this->jsonResponse(200, 'Lead Cached Successfully');
        } else {
            $this->saveLog('lead.created', $freshsalesId, $platform, $phone, 'failed', $stmt->error);
            $this->jsonResponse(500, 'Database Insert Failed');
        }
    }
    // ──────────────────────────────────────────────────────────────
    // 2. CSV Export Module: DMT লিড এক্সপোর্ট করবে (১৩টি নির্দিষ্ট কলাম সহ)
    // ──────────────────────────────────────────────────────────────
    public function exportCsv(): void
    {
        if (session_status() === PHP_SESSION_NONE) session_start();
        
        $ids = $_POST['ids'] ?? [];
        if (empty($ids)) {
            $_SESSION['error'] = "No leads selected for export!";
            header("Location: " . $GLOBALS['base_url'] . "/digital-marketing/freshsales-leads");
            exit;
        }
        // CSV Header (আমাদের বিদ্যমান Leads CSV ফরম্যাট এবং ইউজারের দেওয়া ১৩টি কলাম)
        $headers = [
            'campaign_name',
            'platform',
            'which_apartment_size_are_you_interested_in',
            'which_floor_are_you_for_shop',
            'when_are_you_planning_to_buy',
            'would_you_like_to_schedule_a_site_visit',
            'when_is_the_best_time_to_contact_you',
            'full_name',
            'job_title',
            'company_name',
            'phone_number',
            'city',
            'country'
        ];
        // CSV তৈরি
        header('Content-Type: text/csv; charset=utf-8');
        header('Content-Disposition: attachment; filename="freshsales_leads_' . date('Y-m-d_H-i-s') . '.csv"');
        
        $output = fopen('php://output', 'w');
        fputcsv($output, $headers);
        $idPlaceholders = implode(',', array_fill(0, count($ids), '?'));
        $stmt = $this->db->prepare("
            SELECT id, campaign_name, platform, 
                   which_apartment_size_are_you_interested_in, which_floor_are_you_for_shop, 
                   when_are_you_planning_to_buy, would_you_like_to_schedule_a_site_visit, 
                   when_is_the_best_time_to_contact_you, full_name, job_title, company_name, 
                   phone_number, city, country 
            FROM freshsales_leads_cache
            WHERE id IN ($idPlaceholders)
        ");
        
        $types = str_repeat('i', count($ids));
        $stmt->bind_param($types, ...$ids);
        $stmt->execute();
        $result = $stmt->get_result();
        $exportedIds = [];
        while ($row = $result->fetch_assoc()) {
            fputcsv($output, [
                $row['campaign_name'],
                $row['platform'],
                $row['which_apartment_size_are_you_interested_in'],
                $row['which_floor_are_you_for_shop'],
                $row['when_are_you_planning_to_buy'],
                $row['would_you_like_to_schedule_a_site_visit'],
                $row['when_is_the_best_time_to_contact_you'],
                $row['full_name'],
                $row['job_title'],
                $row['company_name'],
                $row['phone_number'],
                $row['city'],
                $row['country']
            ]);
            $exportedIds[] = $row['id'];
        }
        fclose($output);
        // লিডগুলোকে Exported মার্ক করা
        if (!empty($exportedIds)) {
            $updatePlaceholders = implode(',', array_fill(0, count($exportedIds), '?'));
            $updateStmt = $this->db->prepare("
                UPDATE freshsales_leads_cache 
                SET is_exported = 1, exported_at = NOW() 
                WHERE id IN ($updatePlaceholders)
            ");
            $updateStmt->bind_param(str_repeat('i', count($exportedIds)), ...$exportedIds);
            $updateStmt->execute();
        }
        exit;
    }
    private function saveLog(string $event, ?string $fsId, ?string $platform, ?string $phone, string $status, ?string $error): void
    {
        $stmt = $this->db->prepare("
            INSERT INTO freshsales_webhook_logs (event_type, freshsales_id, platform, phone_number, status, error_message)
            VALUES (?, ?, ?, ?, ?, ?)
        ");
        $stmt->bind_param('ssssss', $event, $fsId, $platform, $phone, $status, $error);
        $stmt->execute();
    }
    private function jsonResponse(int $code, string $message): void
    {
        http_response_code($code);
        header('Content-Type: application/json');
        echo json_encode(['status' => $code, 'message' => $message]);
        exit;
    }
}
